<?xml version="1.0" encoding="utf-8"?>
<!-- Un elemento de la línea de tiempo del historial -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <!-- Punto y línea vertical -->
    <LinearLayout
        android:layout_width="24dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <View
            android:id="@+id/puntoTiempo"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/circulo"
            android:backgroundTint="?attr/colorPrimary" />

        <View
            android:id="@+id/lineaTiempo"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:background="@color/primario_contenedor" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingBottom="16dp">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/txtCambio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Abierto → En proceso"
            android:textStyle="bold" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/txtComentario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Comentario del técnico" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/txtUsuarioFecha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Luis Paredes · 06/11/2026 10:30"
            android:textColor="@color/texto_secundario"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
