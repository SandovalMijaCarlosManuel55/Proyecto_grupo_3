<?xml version="1.0" encoding="utf-8"?>
<!-- Perfil del usuario: datos del JWT y cierre de sesión -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.fragments.PerfilFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <com.google.android.material.card.MaterialCardView style="@style/Tarjeta">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/txtIniciales"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:background="@drawable/circulo"
                    android:backgroundTint="?attr/colorPrimary"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceHeadlineMedium"
                    android:textColor="?attr/colorOnPrimary"
                    android:textStyle="bold"
                    tools:text="CM" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/txtNombre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceTitleLarge"
                    android:textStyle="bold"
                    tools:text="Carlos Mendoza" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipRol"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:clickable="false"
                    app:chipIcon="@drawable/ic_persona"
                    tools:text="Administrador" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView style="@style/Tarjeta">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/TituloSeccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_persona"
                    android:text="Datos de la cuenta" />

                <include
                    android:id="@+id/datoCorreo"
                    layout="@layout/item_dato" />

                <include
                    android:id="@+id/datoEmpresa"
                    layout="@layout/item_dato" />

                <include
                    android:id="@+id/datoPermisos"
                    layout="@layout/item_dato" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Solo Administrador -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMetricas"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="Ver reportes y métricas"
            android:visibility="gone"
            app:icon="@drawable/ic_metricas" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCerrarSesion"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/estado_error"
            android:text="@string/cerrar_sesion"
            app:icon="@drawable/ic_logout" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
