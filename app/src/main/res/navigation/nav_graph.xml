<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="pe.edu.usat.incidentapp.ui.fragments.LoginFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_login">

        <!-- Al iniciar sesión se elimina el login de la pila -->
        <action
            android:id="@+id/action_login_to_lista"
            app:destination="@id/listaIncidentesFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/listaIncidentesFragment"
        android:name="pe.edu.usat.incidentapp.ui.fragments.ListaIncidentesFragment"
        android:label="@string/titulo_lista"
        tools:layout="@layout/fragment_lista_incidentes">

        <action
            android:id="@+id/action_lista_to_nuevo"
            app:destination="@id/nuevoIncidenteFragment" />

        <action
            android:id="@+id/action_lista_to_detalle"
            app:destination="@id/detalleIncidenteFragment" />
    </fragment>

    <!-- Detalle: recibe el id del incidente con SafeArgs -->
    <fragment
        android:id="@+id/detalleIncidenteFragment"
        android:name="pe.edu.usat.incidentapp.ui.fragments.DetalleIncidenteFragment"
        android:label="@string/titulo_detalle"
        tools:layout="@layout/fragment_detalle_incidente">

        <argument
            android:name="idIncidente"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/nuevoIncidenteFragment"
        android:name="pe.edu.usat.incidentapp.ui.fragments.NuevoIncidenteFragment"
        android:label="@string/titulo_nuevo"
        tools:layout="@layout/fragment_nuevo_incidente" />

    <!-- Mapa de sucursales y técnicos (se abre desde el menú de la barra superior) -->
    <fragment
        android:id="@+id/mapaFragment"
        android:name="pe.edu.usat.incidentapp.ui.fragments.MapaFragment"
        android:label="@string/titulo_mapa"
        tools:layout="@layout/fragment_mapa" />

    <!-- Perfil del usuario y cierre de sesión (menú de la barra superior) -->
    <fragment
        android:id="@+id/perfilFragment"
        android:name="pe.edu.usat.incidentapp.ui.fragments.PerfilFragment"
        android:label="@string/titulo_perfil"
        tools:layout="@layout/fragment_perfil">

        <action
            android:id="@+id/action_perfil_to_metricas"
            app:destination="@id/metricasFragment" />
    </fragment>

    <!-- Reportes y métricas: solo Administrador -->
    <fragment
        android:id="@+id/metricasFragment"
        android:name="pe.edu.usat.incidentapp.ui.fragments.MetricasFragment"
        android:label="@string/titulo_metricas"
        tools:layout="@layout/fragment_metricas" />

</navigation>
